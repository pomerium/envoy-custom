_extra_compile_flags = [
    # Note: we have a patch that removes these flags from envoy_copts, so that we can add them
    # here instead, since flags set here are ordered earlier in the compiler command args. This
    # prevents extra warning related flags from being overridden.
    "-Wall",
    "-Wextra",
    "-Werror",
]

_extra_cxx_flags = [
    "-Wno-missing-designated-field-initializers",
]

llvm.toolchain(
    name = "llvm_toolchain",
    cxx_standard = {"": "c++26"},
    extra_compile_flags = {
        "linux-x86_64": _extra_compile_flags,
        "linux-aarch64": _extra_compile_flags,
        "darwin-aarch64": _extra_compile_flags,
    },
    extra_cxx_flags = {
        "linux-x86_64": _extra_cxx_flags,
        "linux-aarch64": _extra_cxx_flags,
        "darwin-aarch64": _extra_cxx_flags,
    },
    extra_link_flags = {
        "linux-x86_64": [
            "-rtlib=compiler-rt",
            "-l:libunwind.a",
        ],
        "linux-aarch64": [
            "-rtlib=compiler-rt",
            "-l:libunwind.a",
        ],
        "darwin-aarch64": ["-rtlib=compiler-rt"],
    },
    libclang_rt = {
        "@cxx_cross_libs_linux_arm64//:lib/libclang_rt.builtins.a": "aarch64-unknown-linux-gnu/libclang_rt.builtins.a",
