sysroot = use_repo_rule("//bazel/sysroots:sysroot.bzl", "sysroot")
sysroot(name = "minimal_sysroot_linux_amd64", arch = "amd64", os = "linux")
sysroot(name = "minimal_sysroot_linux_arm64", arch = "arm64", os = "linux")
sysroot(name = "minimal_sysroot_macos_arm64", arch = "arm64", os = "macos")

llvm_macos_utils = use_repo_rule("//bazel/llvm_macos_utils:llvm_macos_utils.bzl", "llvm_macos_utils")
