llvm_extras(name = "llvm_extras_linux_arm64", arch = "arm64", os = "linux")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.cxx_cross_lib(
    name = "llvm_toolchain",
    label = "@cxx_cross_libs_linux_arm64//:cxx_cross_libs",
    targets = ["linux-aarch64"],
)
llvm.cxx_cross_lib(
    name = "llvm_toolchain",
    label = "@cxx_cross_libs_darwin_arm64//:cxx_cross_libs",
    targets = ["darwin-aarch64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@minimal_sysroot_linux_amd64//:sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@minimal_sysroot_linux_arm64//:sysroot",
    targets = ["linux-aarch64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@minimal_sysroot_macos_arm64//:sysroot",
    targets = ["darwin-aarch64"],
)

