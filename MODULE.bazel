# override envoy llvm setup

cxx_cross_libs = use_repo_rule("//bazel/cxx_libs:cxx_cross_libs.bzl", "cxx_cross_libs")
cxx_cross_libs(name = "cxx_cross_libs_linux_arm64", arch = "arm64", os = "linux")
