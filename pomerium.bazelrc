common --registry=file://%workspace%/bazel

build:asan-common --test_env=UBSAN_SYMBOLIZER_PATH
build:tsan --test_env=TSAN_SYMBOLIZER_PATH

build --define=google_grpc=disabled

# Force all cc targets built with the llvm toolchain to use compiler-rt and libunwind. This removes
# the dependency on libgcc.
common:clang-common --@toolchains_llvm//toolchain/config:compiler-rt=true
common:clang-common --@toolchains_llvm//toolchain/config:libunwind=true

build --macos_minimum_os=14.5
build:linux --features=-libtool

build:coverage --@envoy//tools/coverage:config=@pomerium_envoy//test:coverage_config

build --features=external_include_paths

# Disable commonly encountered warnings in all external dependencies
build --per_file_copt=^(external|bazel-out/.*/bin/external)/.*@-Wno-unused-parameter,-Wno-unused-but-set-global,-Wno-sign-compare
build --host_per_file_copt=^(external|bazel-out/.*/bin/external)/.*@-Wno-unused-parameter,-Wno-unused-but-set-global,-Wno-sign-compare

# Disable warnings in specific external dependencies
build --per_file_copt=external/protobuf.*/.*@-Wno-missing-field-initializers
build --host_per_file_copt=external/protobuf.*/.*@-Wno-missing-field-initializers
build --per_file_copt=external/tcmalloc.*/.*@-Wno-attribute-alias
build --host_per_file_copt=external/tcmalloc.*/.*@-Wno-attribute-alias
build --per_file_copt=external/gperftools.*/.*@-Wno-unused-function,-Wno-implicit-exception-spec-mismatch,-Wno-missing-exception-spec
build --host_per_file_copt=external/gperftools.*/.*@-Wno-unused-function,-Wno-implicit-exception-spec-mismatch,-Wno-missing-exception-spec

# Disable cgo to prevent C toolchain flags from affecting go builds
build --@rules_go//go/config:pure=true

common:buildbarn --remote_executor=grpc://frontend.buildbarn.svc.cluster.local:8980
common:buildbarn --remote_cache=grpc://frontend.buildbarn.svc.cluster.local:8980
common:buildbarn --jobs=64
common:buildbarn --remote_timeout=3600
common:buildbarn --remote_max_connections=100
common:buildbarn --host_platform=@pomerium_envoy//bazel/platforms/rbe:linux_x64
common:buildbarn --bes_results_url=https://buildbarn.k8s.bdd.io/bazel-invocations/
common:buildbarn --bes_backend=grpc://portal.buildbarn.svc.cluster.local:8082
common:buildbarn --spawn_strategy=remote,sandboxed
common:buildbarn --remote_download_minimal
